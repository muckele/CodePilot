# CodeLift reads these values from the process environment. This file is a
# reference and is not loaded automatically. Do not commit real credentials.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Set to the exact number of trusted reverse proxies in front of Express. Keep
# zero when clients connect directly; the included nginx topology uses one.
TRUST_PROXY_HOPS=0
CURRICULUM_PATH=./codelift_ai_curriculum_seed_v2_2026.json

# `optional` keeps the public preview available when Mongo is absent. Production
# defaults to `required`; account/progress routes never use in-memory fallback.
PERSISTENCE_MODE=optional
MONGO_URI=mongodb://127.0.0.1:27018/codelift?replicaSet=rs0&directConnection=true
MONGO_DB_NAME=codelift

# AI is deterministic, local, private, and free by default. `python_mock` uses
# the included FastAPI service. `local` uses an Ollama-compatible endpoint.
# `openai` remains inactive unless the provider, external switch, learner
# privacy preference, and per-request consent all allow the call.
AI_PROVIDER=mock
AI_PYTHON_BASE_URL=http://127.0.0.1:8000
AI_LOCAL_BASE_URL=http://127.0.0.1:11434
AI_TIMEOUT_MS=8000
AI_MAX_RETRIES=1
AI_EXTERNAL_ENABLED=false
AI_AGENT_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=
