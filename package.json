{
  "name": "codelift-ai",
  "version": "0.1.0",
  "private": true,
  "description": "A 365-day, mock-first Full-Stack AI Engineering learning accountability platform.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter @codelift/config build && pnpm --filter @codelift/contracts build && pnpm --filter @codelift/curriculum build && pnpm --filter @codelift/evals build && pnpm --filter @codelift/ui build",
    "build": "pnpm build:packages && pnpm --filter @codelift/api build && pnpm --filter @codelift/web build",
    "dev": "pnpm build:packages && pnpm --parallel --filter @codelift/api --filter @codelift/web dev",
    "dev:web": "pnpm build:packages && pnpm --filter @codelift/web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @codelift/api dev",
    "format": "prettier --write . && services/ai/.venv/bin/ruff format services/ai/app",
    "format:check": "prettier --check . && pnpm python:format:check",
    "lint": "eslint . --max-warnings 0 && pnpm python:lint",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck && pnpm e2e:typecheck && pnpm python:typecheck",
    "test": "pnpm build:packages && pnpm -r --if-present test && pnpm python:test",
    "test:integration": "pnpm build:packages && pnpm --filter @codelift/api test:integration",
    "test:component-flow": "pnpm build:packages && pnpm --filter @codelift/web test:component-flow",
    "test:e2e": "pnpm build:packages && pnpm e2e:typecheck && playwright test",
    "e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json",
    "e2e:reset": "tsx e2e/support/reset-database.ts",
    "e2e:serve:api": "pnpm e2e:reset && pnpm --filter @codelift/api build && pnpm --filter @codelift/api start",
    "seed": "pnpm build:packages && pnpm --filter @codelift/api seed",
    "seed:validate": "pnpm build:packages && pnpm --filter @codelift/api seed:validate",
    "browser:evidence": "node infra/scripts/check-browser-evidence.mjs",
    "curriculum:preflight": "pnpm --filter @codelift/curriculum preflight",
    "curriculum:validate": "pnpm --filter @codelift/curriculum validate",
    "curriculum:links": "node infra/scripts/check-curriculum-links.mjs",
    "eval:local": "pnpm build:packages && node --import tsx infra/scripts/eval-local.ts",
    "mcp:check": "node infra/scripts/check-mcp-demo.mjs",
    "compose:check": "docker compose -f infra/compose.yaml config --quiet",
    "compose:smoke": "node infra/scripts/compose-fallback-smoke.mjs",
    "fresh-clone:check": "node infra/scripts/check-fresh-clone.mjs",
    "python:format:check": "services/ai/.venv/bin/ruff format --check services/ai/app",
    "python:lint": "services/ai/.venv/bin/ruff check services/ai/app",
    "python:typecheck": "services/ai/.venv/bin/mypy --strict services/ai/app",
    "python:test": "services/ai/.venv/bin/pytest services/ai/app",
    "python:check": "pnpm python:format:check && pnpm python:lint && pnpm python:typecheck && pnpm python:test",
    "security:check": "node infra/scripts/security-check.mjs",
    "security:audit": "pnpm audit --audit-level high",
    "performance:check": "node infra/scripts/check-bundle.mjs",
    "quality:report": "node infra/scripts/quality-report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
